generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramAccounts InstagramAccount[]
}

model InstagramAccount {
  id                    String   @id @default(cuid())
  userId                String
  instagramUserId       String
  username              String
  accountType           String
  accessTokenEncrypted  String?
  tokenExpiresAt        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                   User?                   @relation(fields: [userId], references: [id])
  metrics                InstagramAccountMetric[]
  media                  InstagramMedia[]
}

model InstagramMedia {
  id                 String   @id @default(cuid())
  instagramAccountId String
  instagramMediaId   String
  mediaType          String
  caption            String?
  permalink          String?
  publishedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account    InstagramAccount                 @relation(fields: [instagramAccountId], references: [id])
  metrics    InstagramMediaMetric[]
}

model InstagramMediaMetric {
  id           String   @id @default(cuid())
  mediaId      String
  capturedAt    DateTime @default(now())
  reach        Int?
  impressions  Int?
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?

  media        InstagramMedia @relation(fields: [mediaId], references: [id])
}

model InstagramAccountMetric {
  id                   String   @id @default(cuid())
  instagramAccountId   String
  capturedAt           DateTime @default(now())
  followers            Int?
  reach                Int?
  impressions          Int?
  profileViews         Int?
  accountsEngaged      Int?

  account              InstagramAccount @relation(fields: [instagramAccountId], references: [id])
}
